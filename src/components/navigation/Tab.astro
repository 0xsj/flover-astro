---
interface Props {
	value: string;
	disabled?: boolean;
	class?: string;
	[key: string]: unknown;
}

const { value, disabled = false, class: className, ...rest } = Astro.props;
---

<button {...rest} type="button" role="tab" aria-selected="false" tabindex="-1" disabled={disabled} class:list={['tab', className]} data-tab-trigger data-tab-value={value}><slot /></button>
