---
type ControlSize = 'sm' | 'md' | 'lg';

interface Props {
	size?: ControlSize;
	mono?: boolean;
	rows?: number;
	class?: string;
	[key: string]: unknown;
}

const { size = 'md', mono = false, rows = 4, class: className, ...rest } = Astro.props;
const sizeClass = `formInput${size[0].toUpperCase()}${size.slice(1)}`;
---

<textarea {...rest} rows={rows} class:list={['formInput', 'formInputMultiline', sizeClass, mono && 'formInputMono', className]}></textarea>
