---
interface Props {
	name: string;
	value: string;
	checked?: boolean;
	disabled?: boolean;
	class?: string;
	[key: string]: unknown;
}

const { name, value, checked = false, disabled = false, class: className, ...rest } = Astro.props;
---

<input
	{...rest}
	type="radio"
	name={name}
	value={value}
	checked={checked}
	disabled={disabled}
	class:list={['radio', className]}
/> 
