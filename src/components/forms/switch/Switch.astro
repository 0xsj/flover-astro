---
interface Props {
	checked?: boolean;
	disabled?: boolean;
	class?: string;
	[key: string]: unknown;
}

const { checked = false, disabled = false, class: className, ...rest } = Astro.props;
---

<button
	{...rest}
	type="button"
	role="switch"
	aria-checked={String(checked)}
	disabled={disabled}
	class:list={['switch', className]}
	data-state={checked ? 'checked' : 'unchecked'}
	data-astro-switch=""
>
	<span class="switchThumb" aria-hidden="true"></span>
	<slot />
</button>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-astro-switch]').forEach((control) => {
		control.addEventListener('click', () => {
			const checked = control.getAttribute('aria-checked') === 'true';
			control.setAttribute('aria-checked', String(!checked));
			control.dataset.state = checked ? 'unchecked' : 'checked';
		});
	});
</script>
