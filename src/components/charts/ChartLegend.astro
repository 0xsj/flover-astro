---
import '../../styles/charts.css';
import type { ChartSeries } from './types';

interface Props {
	series: readonly ChartSeries[];
	label?: string;
}

const { series, label = 'Chart legend' } = Astro.props;
const seriesClass = (item: ChartSeries) => [
	'chartSeries',
	`chartSeries${item.tone ? item.tone[0].toUpperCase() + item.tone.slice(1) : 'Accent'}`,
	`chartSeries${item.line ? item.line[0].toUpperCase() + item.line.slice(1) : 'Solid'}`
];
---

<ul aria-label={label} class="chartLegend">
	{series.map((item) => (
		<li class:list={seriesClass(item)}>
			<svg viewBox="0 0 24 10" width="24" height="10" aria-hidden="true"><line x1="0" y1="5" x2="24" y2="5" class="chartStroke"></line></svg>
			<span class="chartLegendLabel">{item.label}</span>
		</li>
	))}
</ul>
