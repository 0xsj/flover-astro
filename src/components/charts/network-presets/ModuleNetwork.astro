---
import GraphFrame from '../GraphFrame.astro';
import type { GraphFrameProps } from '../../../lib/charts';

type Props = Omit<GraphFrameProps, 'layout' | 'rootId' | 'hulls'> & { hulls: GraphFrameProps['hulls'] };
const { nodes, edges, width, height, hulls, ...rest } = Astro.props as Props;
---

<GraphFrame {...rest} {nodes} {edges} {width} {height} {hulls} layout="force" title="Module network" />
