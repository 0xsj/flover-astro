---
import '../../styles/charts.css';
import ChartData from './ChartData.astro';
import PlotFrame from './PlotFrame.astro';
import type { RankedBar as RankedBarDatum } from '../../lib/charts';
import { band, linear, px } from '../../lib/charts';

interface Props {
	bars: readonly RankedBarDatum[];
	width?: number;
	height?: number;
	yLabel?: string;
	title?: string;
}

const { bars, width = 460, height = 280, yLabel, title = 'Ranked bars' } = Astro.props;
const valid = (bar: RankedBarDatum) => Number.isFinite(bar.value) && bar.value >= 0;
const sorted = [...bars].filter(valid).sort((a, b) => b.value - a.value);
const margin = { top: 14, right: 14, bottom: 52, left: 44 };
const plotWidth = width - margin.left - margin.right;
const plotHeight = height - margin.top - margin.bottom;
const x = band(sorted.map((bar) => bar.id), [0, plotWidth], 0.28);
const y = linear([0, Math.max(...sorted.map((bar) => bar.value), 1)], [plotHeight, 0]);
---

{sorted.length ? (
	<PlotFrame {width} {height} margin={margin} {y} {yLabel} title={title}>
		{sorted.map((bar) => <g><rect class="chartRankedBar" x={px(x(bar.id))} y={px(y(bar.value))} width={px(x.bandWidth)} height={px(plotHeight - y(bar.value))} rx="3"><title>{`${bar.label} · ${bar.value}`}</title></rect><text class="chartBarValueText" x={px(x(bar.id) + x.bandWidth / 2)} y={px(y(bar.value) - 5)} text-anchor="middle">{bar.value}</text><text class="chartBarLabelText" transform={`translate(${px(x(bar.id) + x.bandWidth / 2)} ${px(plotHeight + 12)}) rotate(-38)`} text-anchor="end">{bar.label}</text></g>)}
	</PlotFrame>
) : <p class="chartMarkMessage">{bars.length ? 'Measurements unavailable.' : 'No measurements to display.'}</p>}

<ChartData title={title}>
	<table class="displayTable">
		<caption class="displayTableCaption">{title}</caption>
		<thead class="displayTableHead"><tr class="displayTableRow"><th class="displayTableTh">Item</th><th class="displayTableTh displayTableNumeric">{yLabel ?? 'Value'}</th></tr></thead>
		<tbody>{[...sorted, ...bars.filter((bar) => !valid(bar))].map((bar) => <tr class="displayTableRow"><th scope="row" class="displayTableTh">{bar.label}</th><td class="displayTableTd displayTableNumeric">{valid(bar) ? String(bar.value) : 'Unavailable'}</td></tr>)}</tbody>
	</table>
</ChartData>
