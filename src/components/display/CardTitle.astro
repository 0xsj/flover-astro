---
import Heading from '../typography/Heading.astro';

interface Props {
	level: 1 | 2 | 3 | 4 | 5 | 6;
	size?: 'sm' | 'md' | 'lg' | 'xl';
	class?: string;
	[key: string]: unknown;
}

const { level, size = 'sm', class: className, ...rest } = Astro.props;
---

<Heading {...rest} level={level} size={size} class:list={['displayCardTitle', className]}><slot /></Heading>
