---
interface Props {
	content: string;
	side?: 'top' | 'right' | 'bottom' | 'left';
	class?: string;
	id?: string;
}

const { content, side = 'top', class: className, id = 'astro-tooltip-content' } = Astro.props;
---

<span class:list={['tooltipRoot', className]} data-astro-tooltip>
	<span data-tooltip-trigger><slot /></span>
	<span id={id} class="tooltipContent" role="tooltip" hidden data-tooltip-content data-side={side}>{content}</span>
</span>

<script>
	import { initTooltips } from '../../lib/overlays/runtime';
	initTooltips();
</script>
