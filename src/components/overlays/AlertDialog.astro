---
interface Props {
	defaultOpen?: boolean;
	class?: string;
	id?: string;
}

const { defaultOpen = false, class: className, id } = Astro.props;
---

<div id={id} class:list={['dialogRoot', className]} data-astro-alert-dialog data-alert-dialog-default-open={defaultOpen ? 'true' : undefined}>
	<slot />
</div>

<script>
	import { initAlertDialogs } from '../../lib/overlays/runtime';
	initAlertDialogs();
</script>
