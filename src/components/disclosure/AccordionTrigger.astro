---
interface Props {
	level?: 2 | 3 | 4 | 5 | 6;
	class?: string;
	[key: string]: unknown;
}

const { level = 3, class: className, ...rest } = Astro.props;
const Tag = `h${level}` as keyof HTMLElementTagNameMap;
---

<Tag class="accordionHeading">
	<button {...rest} type="button" class:list={['accordionTrigger', className]} aria-expanded="false" data-accordion-trigger>
		<span><slot /></span><span class="accordionChevron" aria-hidden="true">⌄</span>
	</button>
</Tag>
