---
import '../../styles/shells.css';
import Heading from '../typography/Heading.astro';
import Text from '../typography/Text.astro';

interface Props {
	title: string;
	description?: string;
	footer?: string;
	level?: 1 | 2 | 3 | 4 | 5 | 6;
	class?: string;
	[key: string]: unknown;
}

const { title, description, footer, level = 2, class: className, ...rest } = Astro.props;
const hasFooter = footer !== undefined || Astro.slots.has('footer');
---

<div {...rest} class:list={['shellContextSidebar', className]}>
	<div class="shellContextHeader">
		<Heading {level} size="sm">{title}</Heading>
		{description && <Text size="sm" tone="quiet">{description}</Text>}
	</div>
	<div class="shellContextContent"><slot /></div>
	{hasFooter && <div class="shellContextFooter">{footer}<slot name="footer" /></div>}
</div>
