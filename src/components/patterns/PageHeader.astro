---
import Heading from '../typography/Heading.astro';
import Text from '../typography/Text.astro';

interface Props {
	title: string;
	description?: string;
	class?: string;
}

const { title, description, class: className, ...rest } = Astro.props;
---

<header {...rest} class:list={['pageHeader', className]}>
	<div class="pageHeaderCopy">
		<Heading level={1} size="lg">{title}</Heading>
		{description && <Text size="lg" tone="muted" class="pageHeaderDescription">{description}</Text>}
	</div>
	<div class="pageHeaderActions"><slot name="actions" /></div>
</header>
