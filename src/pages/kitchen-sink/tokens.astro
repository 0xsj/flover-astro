---
import AuditTable from '../../components/kitchen-sink/AuditTable.astro';
import Case from '../../components/kitchen-sink/Case.astro';
import Scale from '../../components/kitchen-sink/Scale.astro';
import Section from '../../components/kitchen-sink/Section.astro';
import Swatches from '../../components/kitchen-sink/Swatches.astro';
import TokenChips from '../../components/kitchen-sink/TokenChips.astro';
import KitchenSinkLayout from '../../layouts/KitchenSinkLayout.astro';
import { audit } from '../../lib/kitchen-sink/token-audit';
import primitivesSource from '../../styles/tokens/primitives.css?raw';
import semanticSource from '../../styles/tokens/semantic.css?raw';

const checks = audit(primitivesSource, semanticSource);

const INK = ['--ink', '--ink-2', '--ink-3', '--ink-4'];
const SURFACES = ['--surface-ground', '--surface-rail', '--surface-sunk', '--surface-panel', '--surface-panel-2', '--surface-raised'];
const ACCENT = ['--accent', '--accent-dim', '--fill', '--fill-hover', '--warn', '--crit', '--info'];
const PRIMITIVE = [
	{ name: 'neutral', tokens: ['--neutral-0', '--neutral-25', '--neutral-50', '--neutral-100', '--neutral-150', '--neutral-200', '--neutral-300', '--neutral-400', '--neutral-500', '--neutral-550', '--neutral-600', '--neutral-650', '--neutral-700', '--neutral-750', '--neutral-800', '--neutral-850', '--neutral-900', '--neutral-925', '--neutral-950', '--neutral-975', '--neutral-1000', '--neutral-max'] },
	{ name: 'lavender — the Astro accent family', tokens: ['--lavender-300', '--lavender-400', '--lavender-500', '--lavender-600', '--lavender-700', '--lavender-800', '--lavender-900', '--lavender-tint-dark', '--lavender-line-dark', '--lavender-tint-light', '--lavender-line-light'] },
	{ name: 'amber', tokens: ['--amber-400', '--amber-800', '--amber-tint-dark', '--amber-line-dark', '--amber-tint-light', '--amber-line-light'] },
	{ name: 'red', tokens: ['--red-400', '--red-800', '--red-tint-dark', '--red-line-dark', '--red-tint-light', '--red-line-light'] },
	{ name: 'blue', tokens: ['--blue-400', '--blue-800', '--blue-tint-dark', '--blue-line-dark', '--blue-tint-light', '--blue-line-light'] },
	{ name: 'alpha', tokens: ['--alpha-w-045', '--alpha-w-07', '--alpha-w-075', '--alpha-w-12', '--alpha-w-20', '--alpha-b-035', '--alpha-b-06', '--alpha-b-08', '--alpha-b-13', '--alpha-b-22'] }
];
const SEMANTIC = [
	{ name: 'surface', tokens: [...SURFACES, '--surface-hover', '--surface-hover-2'] },
	{ name: 'line', tokens: ['--line', '--line-strong', '--line-heavy'] },
	{ name: 'ink', tokens: INK },
	{ name: 'accent + fill', tokens: ['--accent', '--accent-dim', '--accent-tint', '--accent-line', '--fill', '--fill-hover', '--fill-ink'] },
	{ name: 'status', tokens: ['--warn', '--warn-tint', '--warn-line', '--crit', '--crit-tint', '--crit-line', '--info', '--info-tint', '--info-line'] },
	{ name: 'scrim', tokens: ['--scrim'] },
	{ name: 'shadow', tokens: ['--shadow'], kind: 'shadow' as const }
];
const SPACE = ['--space-1', '--space-2', '--space-3', '--space-4', '--space-5', '--space-6', '--space-7', '--space-8', '--space-9', '--space-10', '--space-11', '--space-12'];
const RADIUS = ['--radius-1', '--radius-2', '--radius-3', '--radius-4', '--radius-pill'];
const CONTROL = ['--control-sm', '--control-md', '--control-lg'];
---

<KitchenSinkLayout title="Tokens · flover-astro" description="The flover-astro design token catalog.">
	<Section id="tokens" title="Tokens" blurb="The named contract between the Astro port's visual language and its components.">
		<Case title="Contrast audit" note="Computed from the token source for both supported themes.">
			<div class="audits">
				<AuditTable theme="dark" rows={checks.dark} />
				<AuditTable theme="light" rows={checks.light} />
			</div>
			<p class="limits">This is a source-level audit of opaque hex pairs. Alpha colors, shadows, gradients, and composited content still need browser-level review.</p>
		</Case>

		<Case title="Ink" note="monotonic in prominence in both themes">
			{INK.map((token) => (
				<div class="row">
					<span class="rowLabel">{token}</span>
					<span style={`color: var(${token})`}>A source said something. That is all that is ever held.</span>
				</div>
			))}
		</Case>

		<Case title="Surfaces" note="ground is furthest back; raised is nearest">
			<TokenChips tokens={SURFACES} />
		</Case>

		<Case title="Accent and status" note="lavender is the Astro accent; status colors retain their own semantic meaning">
			<TokenChips tokens={ACCENT} />
			<div class="row">
				<span class="rowLabel">three states</span>
				<span style="color: var(--accent)">● found</span>
				<span style="color: var(--ink-3)">— none</span>
				<span style="color: var(--ink-4)">·· never checked</span>
			</div>
		</Case>

		<Case title="Primitive palette" note="Raw ramps stay available for controlled component-level use." source="src/styles/tokens/primitives.css">
			<Swatches ramps={PRIMITIVE} />
			<pre slot="source" class="code"><code>{primitivesSource}</code></pre>
		</Case>

		<Case title="Semantic roles" note="Components should consume these names rather than reaching directly for raw palette values." source="src/styles/tokens/semantic.css">
			<Swatches ramps={SEMANTIC} />
			<pre slot="source" class="code"><code>{semanticSource}</code></pre>
		</Case>

		<Case title="Scale" note="space, radius and control height">
			<Scale space={SPACE} radius={RADIUS} control={CONTROL} />
		</Case>
	</Section>
</KitchenSinkLayout>
