---
import { Badge } from '../../components/display';
import { Box, Container, Flex, Separator, SPACE_STEPS } from '../../components/layout';
import Case from '../../components/kitchen-sink/Case.astro';
import Section from '../../components/kitchen-sink/Section.astro';
import KitchenSinkLayout from '../../layouts/KitchenSinkLayout.astro';
import layoutSource from '../../styles/layout.css?raw';

const SPACE = SPACE_STEPS.filter((step) => step > 0);
---

<KitchenSinkLayout title="Layout · flover-astro" description="The flover-astro layout primitive catalog.">
	<Section id="layout" title="Layout" blurb="Four primitives and a spacing shorthand. The shorthand resolves to the existing tokens and emits an inline style, so it adds nothing to the cascade and invents no second scale — which is what keeps it a typed accessor to the token layer rather than a utility framework.">
		<Case title="Space props" note="p · px · py · pt · pb · pl · pr · m… · gap — twelve steps, one scale">
			<div class="scale">
				{SPACE.map((step) => (
					<div class="scaleRow">
						<span class="mono">p={'{'}{step}{'}'}</span>
						<span class="mono" aria-hidden="true"></span>
						<Box p={step} class="spaceBox"><span class="spaceInner"></span></Box>
					</div>
				))}
			</div>
			<p class="limits"><code>p={'{'}3{'}'}</code> is <code>var(--space-3)</code> — not a number this utility decided on. There is no second scale to keep in step, and nothing is generated: the props emit an inline style, so <code>@layer primitive</code> is untouched by a caller adjusting a gap.</p>
			<p class="limits"><strong>The edge shorthands are logical.</strong> <code>pl</code> is inline-start, not left — the familiar letters, following the text rather than the screen, so a right-to-left document is correct without a second set of props. Scope is spacing and flow only: no colour, no type, no borders.</p>
		</Case>

		<Case title="Box" note="a div with spacing props, and no appearance of its own">
			<div class="row"><span class="rowLabel">padding</span><Box p={6} class="spaceBox">p={'{'}6{'}'}</Box></div>
			<div class="row"><span class="rowLabel">asymmetric</span><Box py={3} px={8} class="spaceBox">py={'{'}3{'}'} px={'{'}8{'}'}</Box></div>
			<p class="limits">It has no background, border, radius or colour, and takes no props for them. The <code>as</code> prop lets the caller choose the element carrying the spacing, so a Box never needs to add a wrapper.</p>
		</Case>

		<Case title="Flex" note="direction · align · justify · wrap · grow">
			<div class="row"><span class="rowLabel">row</span><Flex gap={4} align="center" class="spaceBox"><Badge tone="accent">one</Badge><Badge>two</Badge><Badge>three</Badge></Flex></div>
			<div class="row"><span class="rowLabel">grow</span><Flex gap={4} class="fullWidth"><Box class="spaceBox" p={3}>fixed</Box><Flex grow class="spaceBox" p={3}>grow — and min-inline-size: 0</Flex></Flex></div>
			<p class="limits"><code>grow</code> also sets <code>min-inline-size: 0</code>. A flex child defaults to <code>auto</code>, which refuses to shrink below its content and overflows the row — the commonest flex defect, and not the caller&rsquo;s fault to fix.</p>
		</Case>

		<Case title="Container" note="centres, and caps in characters rather than pixels">
			<Container width="measure" class="spaceBox">A reading column, capped by <code>--measure</code> in ch units, because legibility depends on characters per line rather than on pixels. The only arrangement decision this group makes on a screen&rsquo;s behalf.</Container>
		</Case>

		<Case title="Separator" note="announced by default; decorative when it is only grouping" source="src/styles/layout.css">
			<div class="row"><span class="rowLabel">horizontal</span><div class="fullWidth"><Box py={3}>above</Box><Separator decorative /><Box py={3}>below</Box></div></div>
			<div class="row"><span class="rowLabel">vertical</span><Flex gap={5} align="center"><span>one</span><Separator orientation="vertical" decorative /><span>two</span></Flex></div>
			<p class="limits">The primitive announces a separator unless told otherwise. Pass <code>decorative</code> for a rule a reader already gets from the headings around it, which is most of them.</p>
			<pre slot="source" class="code"><code>{layoutSource}</code></pre>
		</Case>
	</Section>
</KitchenSinkLayout>
