---
import BaseLayout from './BaseLayout.astro';
import '../styles/kitchen-sink.css';
import { CATALOG, CATALOG_GROUPS } from '../lib/kitchen-sink/catalog';
import { DensityToggle, Mark, ThemeToggle } from '../components/chrome';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<BaseLayout title={title} description={description}>
	<div class="shell">
		<a href="#gallery-main" class="skipLink">Skip to examples</a>
		<header class="header">
			<div class="headerInner">
				<a href="/kitchen-sink" class="wordmark" aria-label="Flover Astro kitchen sink"><Mark /></a>
				<span class="headerLabel">Component catalog</span>
				<div class="controls">
					<a href="/" class="navLink">Home</a>
					<ThemeToggle />
					<DensityToggle />
				</div>
			</div>
		</header>

		<div class="body">
			<aside class="rail" data-catalog-rail>
				<button
					type="button"
					class="mobileNavToggle"
					data-catalog-toggle
					aria-expanded="false"
					aria-controls="catalog-navigation"
				>
					<span aria-hidden="true">☰</span> Browse components
				</button>
				<nav id="catalog-navigation" aria-label="Component catalog" class="catalogNav" data-catalog-nav>
					<a
						href="/kitchen-sink"
						class:list={["catalogLink", pathname === '/kitchen-sink' && 'catalogActive']}
						aria-current={pathname === '/kitchen-sink' ? 'page' : undefined}
					>Overview</a>
					{CATALOG_GROUPS.map((group) => (
						<div class="catalogGroup">
							<p class="caseSection">{group}</p>
							{CATALOG.filter((entry) => entry.group === group).map((entry) => {
								const href = `/kitchen-sink/${entry.id}`;
								return (
									<a
										href={href}
										class:list={["catalogLink", pathname === href && 'catalogActive']}
										aria-current={pathname === href ? 'page' : undefined}
									>{entry.label}</a>
								);
							})}
						</div>
					))}
				</nav>
			</aside>

			<main id="gallery-main" tabindex="-1" class="main" data-gallery-content>
				<div class="sections"><slot /></div>
			</main>

			<aside class="contentsRail">
				<nav aria-label="On this page" data-case-nav></nav>
			</aside>
		</div>
	</div>
</BaseLayout>

<script>
	const toggle = document.querySelector('[data-catalog-toggle]');
	const navigation = document.querySelector('[data-catalog-nav]');
	const closeCatalog = () => {
		if (!(toggle instanceof HTMLElement) || !(navigation instanceof HTMLElement)) return;
		toggle.setAttribute('aria-expanded', 'false');
		navigation.removeAttribute('data-open');
	};

	toggle?.addEventListener('click', () => {
		if (!(toggle instanceof HTMLElement) || !(navigation instanceof HTMLElement)) return;
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		if (open) navigation.removeAttribute('data-open');
		else navigation.dataset.open = '';
	});
	navigation?.addEventListener('click', (event) => {
		if (event.target instanceof Element && event.target.closest('a')) closeCatalog();
	});
	toggle?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeCatalog();
			toggle.focus();
		}
	});

	const caseNavigation = document.querySelector('[data-case-nav]');
	const cases = () => [...document.querySelectorAll('[data-gallery-content] [data-case]')];
	const updateActiveCase = () => {
		if (!(caseNavigation instanceof HTMLElement)) return;
		const entries = cases();
		const active = entries
			.filter((entry) => entry.getBoundingClientRect().top <= 140)
			.at(-1)?.id ?? entries[0]?.id;
		caseNavigation.querySelectorAll('a').forEach((link) => {
			const current = link.getAttribute('href') === `#${active}`;
			link.classList.toggle('caseLinkActive', current);
			if (current) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};
	const renderCaseNavigation = () => {
		if (!(caseNavigation instanceof HTMLElement)) return;
		const entries = cases();
		caseNavigation.replaceChildren();
		if (!entries.length) return;
		const heading = document.createElement('p');
		heading.className = 'caseSection';
		heading.textContent = 'On this page';
		caseNavigation.append(heading);
		entries.forEach((entry) => {
			const link = document.createElement('a');
			link.className = 'caseLink';
			link.href = `#${entry.id}`;
			link.textContent = entry.dataset.case ?? '';
			caseNavigation.append(link);
		});
		updateActiveCase();
	};

	renderCaseNavigation();
	window.addEventListener('scroll', updateActiveCase, { passive: true });
	window.addEventListener('resize', updateActiveCase);
	window.addEventListener('hashchange', updateActiveCase);
</script>
