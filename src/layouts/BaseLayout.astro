---
import '../styles/app.css';
import '../styles/reset.css';
import '../styles/tokens/primitives.css';
import '../styles/tokens/semantic.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/space.css';
import '../styles/tokens/shape.css';
import '../styles/tokens/motion.css';
import '../styles/tokens/z.css';
import '../styles/tokens/chart.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/chrome.css';
import '../styles/patterns.css';
import '../styles/shells.css';
import '../styles/forms.css';
import '../styles/feedback.css';
import '../styles/navigation.css';
import '../styles/disclosure.css';
import '../styles/utility.css';
import '../styles/overlays.css';
import '../styles/display.css';
import '../styles/workspaces.css';
import '../styles/auth-app.css';
import '../styles/base.css';
import { RUNTIME_BOOT_SCRIPT } from '../lib/runtime';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'flover-astro',
	description = 'An opinionated Astro starter with a composable design system.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline set:html={RUNTIME_BOOT_SCRIPT}></script>
	</head>
	<body>
		<slot />
	</body>
</html>
